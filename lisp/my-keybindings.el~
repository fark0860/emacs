(keymap-set global-map "C-a b k" 'kill-current-buffer)
(keymap-set global-map "C-a b i" 'ibuffer)
(keymap-set global-map "C-a b s" 'save-buffer)
(keymap-set global-map "C-a b n" 'scratch-buffer)

;; ---- Window (C-a w ...) ----
