(keymap-set global-map "C-a t M-t" 'tab-new-to)
(keymap-set global-map "C-a t u"   'tab-undo)
(keymap-set global-map "C-a t k"   'tab-close)
(keymap-set global-map "C-a t m"   'tab-move)
