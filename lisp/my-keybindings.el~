;; ============================================================================
;; 4. C-q ISOLATED MODE LOCAL MAPS (Built-in Hook Method)
;; ============================================================================
;; We map sub-keys directly to local maps in major mode hooks.
;; This prevents keys from sticking to C-q in other buffers.

;; ---- Org Mode ----
(add-hook 'org-mode-hook
          (lambda ()
            (keymap-local-set "C-q p l" 'org-latex-preview)
            (keymap-local-set "C-q p b" 'org-babel-execute-buffer)
            (keymap-local-set "C-q p i" 'org-inline-image-toggle)
            (keymap-local-set "C-q x t" 'org-toggle-checkbox)
            (keymap-local-set "C-q x d" 'org-deadline)))

;; ---- CSS Mode ----
(add-hook 'css-mode-hook
          (lambda ()
            (keymap-local-set "C-q c i" 'insert-color)
            (keymap-local-set "C-q c r" 'css-replace-hex)))

;; ---- Shell Mode ----
(add-hook 'shell-mode-hook
          (lambda ()
            (keymap-local-set "C-q k" 'comint-clear-buffer)))

;; ============================================================================
;; 5. ABSOLUTE NAVIGATIONAL INTERCEPTS (Emulation Layer)
;; ============================================================================

(defvar my-intercept-navigation-map (make-sparse-keymap))

(keymap-set my-intercept-navigation-map "C-l"   'move-end-of-line)
(keymap-set my-intercept-navigation-map "C-M-l" 'move-beginning-of-line)
(keymap-set my-intercept-navigation-map "C-w"   'forward-word)
(keymap-set my-intercept-navigation-map "C-M-w" 'backward-word)
(keymap-set my-intercept-navigation-map "C-s"   'forward-sentence)
(keymap-set my-intercept-navigation-map "C-M-s" 'backward-sentence)
(keymap-set my-intercept-navigation-map "C-p"   'forward-paragraph)
(keymap-set my-intercept-navigation-map "C-M-p" 'backward-paragraph)
(keymap-set my-intercept-navigation-map "C-f"   'forward-sexp)
(keymap-set my-intercept-navigation-map "C-M-f" 'backward-sexp)
(keymap-set my-intercept-navigation-map "C-n"   'next-line)
(keymap-set my-intercept-navigation-map "C-M-n" 'previous-line)
(keymap-set my-intercept-navigation-map "C-b"   'end-of-buffer)
(keymap-set my-intercept-navigation-map "C-M-b" 'beginning-of-buffer)

(add-to-list 'emulation-mode-map-alists `((t . ,my-intercept-navigation-map)))

