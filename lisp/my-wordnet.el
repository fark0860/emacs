            ("-domtr" . "Display terms in domain (Adverb)")
            ("-subsn" . "Display substance meronyms (HAS SUBSTANCE)")
            ("-partn" . "Display part meronyms (HAS PART)")
            ("-membn" . "Display member meronyms (HAS MEMBER)")
            ("-meron" . "Display all meronyms (PART, MEMBER, SUBSTANCE)")
            ("-hmern" . "Display meronyms tree recursively")
