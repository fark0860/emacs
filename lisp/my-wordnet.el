            ("-holon" . "Display all holonyms (PART, MEMBER, SUBSTANCE OF)")
            ("-hholn" . "Display holonyms tree recursively")
            ("-entav" . "Display entailment relations")
            ("-framv" . "Display applicable verb sentence frames")
